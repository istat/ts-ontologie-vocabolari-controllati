#################################################################
#    General axioms

#################################################################


[ rdf:type owl:Class ;
  owl:unionOf ( :AutonomousProvince
                :FreeMunicipalConsortium
                :MetropolitanCity
                :Non-administrativeUnit
              ) ;
  rdfs:subClassOf :Province
] .


[ rdf:type owl:Class ;
  owl:unionOf ( :CompliantAddressStatus
                :NonCompliantAddressStatus
              ) ;
  rdfs:subClassOf :AddressComplianceStatus
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AutonomousProvince
                :FreeMunicipalConsortium
                :MetropolitanCity
                :Non-administrativeUnit
              )
] .
