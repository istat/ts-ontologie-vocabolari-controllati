#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/italia/onto/citizen/bornInState
CTZ:bornInState rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain CPV:Person ;
                rdfs:range CTZ:State ;
                rdfs:label "born in state"@en ,
                           "nato in stato"@it .


###  https://w3id.org/italia/onto/citizen/bornInUngovernatedTerritory
CTZ:bornInUngovernatedTerritory rdf:type owl:ObjectProperty ;
                                rdfs:domain CPV:Person ;
                                rdfs:range CLV:UngovernedTerritory .


###  https://w3id.org/italia/onto/citizen/hasCitizenship
CTZ:hasCitizenship rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain CTZ:CitizenshipInTime ;
                   rdfs:range rpo:Citizenship ;
                   rdfs:label "ha cittadinanza"@it ,
                              "has citizenship"@en .


###  https://w3id.org/italia/onto/citizen/hasCitizenshipInState
CTZ:hasCitizenshipInState rdf:type owl:ObjectProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain CTZ:CitizenshipInTime ;
                          rdfs:range CTZ:State ;
                          rdfs:label "ha stato di cittadinanza"@it ,
                                     "has citizenship in state"@en .


###  https://w3id.org/italia/onto/citizen/hasCitizenshipName
CTZ:hasCitizenshipName rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ,
                                owl:InverseFunctionalProperty ;
                       rdfs:domain CTZ:State ;
                       rdfs:range rpo:Citizenship ;
                       rdfs:label "ha denominazione di cittadinanza"@it ,
                                  "has citizenship name"@en .


###  https://w3id.org/italia/onto/citizen/hasCitizenshipinTime
CTZ:hasCitizenshipinTime rdf:type owl:ObjectProperty ,
                                  owl:InverseFunctionalProperty ;
                         rdfs:domain CPV:Person ,
                                     [ rdf:type owl:Class ;
                                       owl:complementOf CPV:Stateless
                                     ] ;
                         rdfs:range CTZ:CitizenshipInTime ;
                         rdfs:label "ha cittadinanza nel periodo"@it ,
                                    "has citizenship in time"@en .


###  https://w3id.org/italia/onto/citizen/hasSovereignty
CTZ:hasSovereignty rdf:type owl:ObjectProperty ,
                            owl:InverseFunctionalProperty ;
                   rdfs:domain CTZ:State ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:unionOf ( CLV:Country
                                              CLV:GovernedTerritory
                                            )
                              ] ;
                   rdfs:label "ha sovranità"@it ,
                              "has sovereignty"@en .


###  https://w3id.org/italia/onto/citizen/isPredominantCitizenshipOver
CTZ:isPredominantCitizenshipOver rdf:type owl:ObjectProperty ,
                                          owl:InverseFunctionalProperty ;
                                 rdfs:domain CTZ:CitizenshipInTime ;
                                 rdfs:range CTZ:CitizenshipInTime ;
                                 rdfs:label "is predominant citizenship over"@en ,
                                            "è cittadinanza prevalente su"@it .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/italia/onto/CLV/Country
CLV:Country rdf:type owl:Class ;
            owl:disjointWith CLV:GovernedTerritory .


###  https://w3id.org/italia/onto/CLV/GovernedTerritory
CLV:GovernedTerritory rdf:type owl:Class .


###  https://w3id.org/italia/onto/CLV/UngovernedTerritory
CLV:UngovernedTerritory rdf:type owl:Class .


###  https://w3id.org/italia/onto/COV/PublicOrganization
COV:PublicOrganization rdf:type owl:Class .


###  https://w3id.org/italia/onto/CPV/Person
CPV:Person rdf:type owl:Class .


###  https://w3id.org/italia/onto/CPV/Stateless
CPV:Stateless rdf:type owl:Class ;
              owl:disjointWith [ rdf:type owl:Restriction ;
                                 owl:onProperty CTZ:hasCitizenshipinTime ;
                                 owl:someValuesFrom owl:Thing
                               ] .


###  https://w3id.org/italia/onto/RPO/Citizenship
rpo:Citizenship rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty [ owl:inverseOf CTZ:hasCitizenshipName
                                                     ] ;
                                      owl:someValuesFrom owl:Thing
                                    ] .


###  https://w3id.org/italia/onto/TI/TimeIndexedEvent
TI:TimeIndexedEvent rdf:type owl:Class .


###  https://w3id.org/italia/onto/citizen/CitizenshipInTime
CTZ:CitizenshipInTime rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty CTZ:hasCitizenship ;
                                            owl:someValuesFrom owl:Thing
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty CTZ:hasCitizenshipInState ;
                                            owl:someValuesFrom owl:Thing
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf CTZ:hasCitizenshipinTime
                                                           ] ;
                                            owl:someValuesFrom owl:Thing
                                          ] ;
                      rdfs:subClassOf TI:TimeIndexedEvent ;
                      rdfs:label "Citizenship in time"@en ,
                                 "Cittadinanza nel periodo"@it .


###  https://w3id.org/italia/onto/citizen/State
CTZ:State rdf:type owl:Class ;
          rdfs:subClassOf COV:PublicOrganization ;
          rdfs:label "State"@en ,
                     "Stato"@it .


###  https://w3id.org/italia/onto/citizen/UnrecognizedState
CTZ:UnrecognizedState rdf:type owl:Class ;
                      rdfs:subClassOf CTZ:State ;
                      rdfs:label "UnrecognizedState"@it .



