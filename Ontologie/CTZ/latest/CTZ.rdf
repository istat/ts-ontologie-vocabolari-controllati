    <!-- https://w3id.org/italia/onto/citizen/bornInState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/bornInState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/citizen/State"/>
        <rdfs:label xml:lang="en">born in state</rdfs:label>
        <rdfs:label xml:lang="it">nato in stato</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/bornInUngovernatedTerritory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/bornInUngovernatedTerritory">
