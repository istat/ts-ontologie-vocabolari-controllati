        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/UngovernedTerritory"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/hasCitizenship -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/hasCitizenship">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/citizen/CitizenshipInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/RPO/Citizenship"/>
        <rdfs:label xml:lang="it">ha cittadinanza</rdfs:label>
        <rdfs:label xml:lang="en">has citizenship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/hasCitizenshipInState -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/hasCitizenshipInState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/citizen/CitizenshipInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/citizen/State"/>
        <rdfs:label xml:lang="it">ha stato di cittadinanza</rdfs:label>
        <rdfs:label xml:lang="en">has citizenship in state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/hasCitizenshipName -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/hasCitizenshipName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/citizen/State"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/RPO/Citizenship"/>
        <rdfs:label xml:lang="it">ha denominazione di cittadinanza</rdfs:label>
        <rdfs:label xml:lang="en">has citizenship name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/hasCitizenshipinTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/hasCitizenshipinTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:domain>
            <owl:Class>
                <owl:complementOf rdf:resource="https://w3id.org/italia/onto/CPV/Stateless"/>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/citizen/CitizenshipInTime"/>
        <rdfs:label xml:lang="it">ha cittadinanza nel periodo</rdfs:label>
        <rdfs:label xml:lang="en">has citizenship in time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/hasSovereignty -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/hasSovereignty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/citizen/State"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/Country"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/onto/CLV/GovernedTerritory"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="it">ha sovranità</rdfs:label>
        <rdfs:label xml:lang="en">has sovereignty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/onto/citizen/isPredominantCitizenshipOver -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/citizen/isPredominantCitizenshipOver">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/citizen/CitizenshipInTime"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/citizen/CitizenshipInTime"/>
        <rdfs:label xml:lang="en">is predominant citizenship over</rdfs:label>
        <rdfs:label xml:lang="it">è cittadinanza prevalente su</rdfs:label>
    </owl:ObjectProperty>
    


