    <!-- https://w3id.org/italia/onto/RPO/Citizenship -->

    <owl:Class rdf:about="https://w3id.org/italia/onto/RPO/Citizenship">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
