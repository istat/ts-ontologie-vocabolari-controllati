    <!-- https://w3id.org/italia/onto/citizen/CitizenshipInTime -->

    <owl:Class rdf:about="https://w3id.org/italia/onto/citizen/CitizenshipInTime">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/onto/citizen/hasCitizenship"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/onto/citizen/hasCitizenshipInState"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/onto/citizen/hasCitizenshipinTime"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:label xml:lang="en">Citizenship in time</rdfs:label>
        <rdfs:label xml:lang="it">Cittadinanza nel periodo</rdfs:label>
    </owl:Class>
    


