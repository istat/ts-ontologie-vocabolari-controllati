#    fine metadati 
#################################################################

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23A1>
  a skos:Concept, :Demanio;
  rdfs:label "23A1"@it;
  skos:prefLabel "23A1"@it;
  rdfs:comment "Beni appartenenti al patrimonio dello Stato suscettibili di alienazione o utilizzazione economica secondo le disposizioni del Codice civile e della normativa patrimoniale."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "BENI DISPONIBILI"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23A4>
  a skos:Concept, :Demanio;
  rdfs:label "23A4"@it;
  skos:prefLabel "23A4"@it;
  rdfs:comment "Beni patrimoniali costituiti da giacimenti minerari e dalle relative pertinenze fisiche e infrastrutturali, disciplinati dalla normativa mineraria."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "MINIERE E RELATIVE PERTINENZE"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23A5>
  a skos:Concept, :Demanio;
  rdfs:label "23A5"@it;
  skos:prefLabel "23A5"@it;
  rdfs:comment "Beni appartenenti allo Stato e assegnati in uso gratuito o oneroso a pubbliche amministrazioni per finalità istituzionali"@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "BENI ASSEGNATI IN USO GOVERNATIVO"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23A6>
  a skos:Concept, :Demanio;
  rdfs:label "23A6"@it;
  skos:prefLabel "23A6"@it;
  rdfs:comment "Beni del patrimonio dello Stato non alienabili, in quanto destinati a un pubblico servizio o a un uso di pubblica utilità, pur non appartenendo al demanio necessario."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "BENI NON DISPONIBILI"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23B2>
  a skos:Concept, :Demanio;
  rdfs:label "23B2"@it;
  skos:prefLabel "23B2"@it;
  rdfs:comment "Beni patrimoniali dello Stato gravati da diritti reali (usufrutto, servitù, enfiteusi, ecc.) costituiti a favore di soggetti diversi dallo Stato."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "BENI SU CUI GRAVANO DIR. REALI A FAVORE TERZI"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23C3>
  a skos:Concept, :Demanio;
  rdfs:label "23C3"@it;
  skos:prefLabel "23C3"@it;
  rdfs:comment "Diritti reali attivi spettanti allo Stato su beni di proprietà altrui, aventi natura patrimoniale (es. servitù, enfiteusi attiva, usufrutto)."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "DIRITTI REALI SU BENI PATRIMONIALI"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23C3C>
  a skos:Concept, :Demanio;
  rdfs:label "23C3C"@it;
  skos:prefLabel "23C3C"@it;
  rdfs:comment "Diritti reali spettanti allo Stato su beni appartenenti a enti comunali."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "DIR. REALI SU BENI DI PROPRIETA` DI COMUNI"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23C3P>
  a skos:Concept, :Demanio;
  rdfs:label "23C3P"@it;
  skos:prefLabel "23C3P"@it;
  rdfs:comment "Diritti reali spettanti allo Stato su beni appartenenti a enti provinciali."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "DIR. REALI SU BENI DI PROPRIETA` DI PROVINCIE"@it .

<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/TipoCategoriaPatrimonialeImmobile/23C3R>
  a skos:Concept, :Demanio;
  rdfs:label "23C3R"@it;
  skos:prefLabel "23C3R"@it;
  rdfs:comment "Diritti reali spettanti allo Stato su beni appartenenti a enti regionali."@it;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>;
  skos:notation "DIR. REALI SU BENI DI PROPRIETA` DI REGIONI"@it .
