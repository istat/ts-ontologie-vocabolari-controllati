<https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale>
  rdf:type      skos:ConceptScheme , adms:Asset , dcatapit:Dataset ;
  dct:title "Controlled Vocabulary for Asset Categories"@en , "Vocabolario Controllato delle Categorie Patrimoniali"@it ;
  dct:description "La categoria patrimoniale rappresenta la classificazione amministrativo-contabile dei beni immobili e dei diritti reali gestiti dall’Agenzia del Demanio, finalizzata a identificarne la natura giuridica e la modalità di appartenenza o gestione nell’ambito del patrimonio dello Stato. Essa consente di distinguere i beni demaniali e patrimoniali in base alla loro disponibilità, destinazione, o all’esistenza di diritti reali a favore o a carico di soggetti terzi."@it, "The asset category represents the administrative and accounting classification of real estate properties and real rights managed by the State Property Agency, aimed at identifying their legal nature and the way in which they are owned or managed within the State’s assets. It makes it possible to distinguish between demanial and patrimonial assets on the basis of their availability, intended use, or the existence of real rights in favor of or encumbering third parties."@en;
  xkos:numberOfLevels "1" ;
  dct:type <http://purl.org/adms/assettype/CodeList> ;
  adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
  dct:identifier "https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale";
  dct:rightsHolder <https://w3id.org/italia/data/public-organization/agd> ;
  dct:creator <https://w3id.org/italia/data/public-organization/agd>  ;
  dct:publisher <https://w3id.org/italia/data/public-organization/agd> ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/GOVE> ;
  dct:conformsTo  <https://w3id.org/italia/data/standard/SKOS> ;
  dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
  rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/classifications-for-demanio/categoria_patrimoniale> ;
  dcat:keyword "Categoria Patrimoniale"@it, "Asset Category"@en ;
  dcat:distribution <https://w3id.org/italia/data/distribution/categoria_patrimoniale_RDF_Turtle> , <https://w3id.org/italia/data/distribution/categoria_patrimoniale_CSV> , <https://w3id.org/italia/data/distribution/categoria_patrimoniale_XLSX> ;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;
  dct:issued "2025-11-25"^^xsd:date ;
  dct:modified "2025-11-25"^^xsd:date ;
  owl:versionInfo "Versione 0.1"@it ; 
  ndc:keyConcept "Categoria_Patrimoniale" ;
  rdfs:comment "Controlled Vocabulary for Asset Categories"@en , "Vocabolario Controllato delle Categorie Patrimoniali"@it ;
  rdfs:label "Controlled Vocabulary for Asset Categories"@en , "Vocabolario Controllato delle Categorie Patrimoniali"@it ;
  skos:notation "Controlled Vocabulary for Asset Categories"@en , "Vocabolario Controllato delle Categorie Patrimoniali"@it ;       
  skos:prefLabel "Controlled Vocabulary for Asset Categories"@en , "Vocabolario Controllato delle Categorie Patrimoniali"@it .   
   
 
