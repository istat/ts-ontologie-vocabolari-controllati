  rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/uts_costituite> ;
  dcat:keyword "Provincia costituita"@it , "UTS costituite"@it ,  "Established province"@en , "Established UTS"@en ;
