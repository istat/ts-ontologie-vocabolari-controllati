<https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/dug>
    a skos:ConceptScheme , adms:Asset , dcatapit:Dataset ;
    dct:title "Generic urban denominations Controlled Vocabulary"@en ,
              "Vocabolario controllato delle denominazioni urbanistiche generiche"@it ;
    dct:description "Il vocabolario controllato delle Denominazioni Urbanistiche Generiche (DUG) raccoglie e definisce in modo standardizzato i termini utilizzati per qualificare i toponimi stradali, come \"via\", \"viale\", \"piazza\", \"corso\" e \"vicolo\", favorendone l’interpretazione uniforme e l’interoperabilità nei dati relativi agli indirizzi e alla toponomastica."@it ,
	                "The controlled vocabulary of Generic Urban Designations (DUG) collects and standardizes the terms used to qualify street toponyms, such as \"via\", \"viale\", \"piazza\", \"corso\" and \"vicolo\", thereby promoting their consistent interpretation and interoperability in address and toponymy-related data."@en ;
    xkos:numberOfLevels "1" ;
    dct:type <http://purl.org/adms/assettype/CodeList> ;
    adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
    dct:identifier "https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/dug" ;
    dct:rightsHolder <https://w3id.org/italia/data/public-organization/ISTAT> ;
    dct:creator <https://w3id.org/italia/data/public-organization/ISTAT> ;
    dct:publisher <https://w3id.org/italia/data/public-organization/ISTAT> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/REGI> ;
    dct:conformsTo <https://w3id.org/italia/data/standard/SKOS> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
    rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/dug> ;
    dct:subject <https://w3id.org/italia/controlled-vocabulary/themes/environment-and-territory> ;
    dcat:keyword "DUG"@it , "Denominazioni Urbanistiche Generiche"@it , "odonimo"@it , 
				 "DUG"@en , "Generic urban denominations"@en , "odonym"@en  ;
    dcat:distribution <https://w3id.org/italia/data/distribution/dug_RDF_Turtle> ,
                      <https://w3id.org/italia/data/distribution/dug_CSV> ,
                      <https://w3id.org/italia/data/distribution/dug_XLSX> ;
    dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;
    dct:issued "2026-08-10"^^xsd:date ;
