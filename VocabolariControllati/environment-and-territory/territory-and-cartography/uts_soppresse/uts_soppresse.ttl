<https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/uts_soppresse>
  rdf:type      skos:ConceptScheme , adms:Asset , dcatapit:Dataset ;
  dct:title "Controlled Vocabulary of Provinces-Uts Abolished or Transferred to a Foreign State"@en , "Vocabolario Controllato delle Province-Uts soppresse o cedute a Stato estero"@it ;
  dct:description "Vocabolario controllato delle Province-Unità territoriali di livello intermedio tra il Comune e la Regione soppresse o cedute a Stato estero. Tali unità comprendono le province, le città metropolitane, le province autonome, i liberi consorzi di Comuni e le unità territoriali non amministrative (Friuli Venezia Giulia)."@it , "Controlled Vocabulary of Provinces/UTS of intermediate area level between the municipality and the region abolished or transferred to a foreign state. The units include provinces, metropolitan cities, autonomous province (Trentino Alto Adige), free municipal consortiums (Sicilia), and non-administrative units."@en ;
  xkos:numberOfLevels "1" ;
  dct:type <http://purl.org/adms/assettype/CodeList> ;
  adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
  dct:identifier "https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts_soppresse";
  dct:rightsHolder <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dct:creator <https://w3id.org/italia/data/public-organization/ISTAT>  ;
  dct:publisher <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/REGI> ;
  dct:conformsTo  <https://w3id.org/italia/data/standard/SKOS> ;
  dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
  rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/environment-and-territory/territory-and-cartography/uts_soppresse> ;
   dcat:keyword "Provincia soppressa"@it , "UTS soppresse"@it ,  "Abolished province"@en , "Abolished UTS"@en ;
  dcat:distribution <https://w3id.org/italia/data/distribution/uts_soppresse_RDF_Turtle>, <https://w3id.org/italia/data/distribution/uts_soppresse_CSV>, <https://w3id.org/italia/data/distribution/uts_soppresse_XLSX>  ;                             
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;                                                                                                                                                               
  dct:issued "2026-05-13"^^xsd:date ;
