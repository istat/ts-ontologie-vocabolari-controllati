    <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_0_10_30> .

<https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1_10>
  a skos:Concept, cpv:EducationLevel;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level>;
  skos:broader <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1>;
  skos:notation "CTS_1_10";
  clvapit:hasRankOrder "2"^^xsd:int;
  skos:note ""@it;
  skos:prefLabel "Final assessment (primary school)"@en, "Licenza elementare; Certificazione delle competenze"@it;
  skos:altLabel ""@it, ""@en;
  skos:definition ""@en, ""@it;
  skos:narrower <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1_10_10>,
    <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1_10_20> .

<https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1_20>
  a skos:Concept, cpv:EducationLevel;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level>;
  skos:broader <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1>;
  skos:notation "CTS_1_20";
  clvapit:hasRankOrder "2"^^xsd:int;
