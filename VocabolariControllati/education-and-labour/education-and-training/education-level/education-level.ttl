<https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/CTS_1>
  a skos:Concept, cpv:EducationLevel;
  skos:inScheme <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level>;
  skos:broader <https://w3id.org/italia/controlled-vocabulary/education-and-labour/education-and-training/education-level/>;
