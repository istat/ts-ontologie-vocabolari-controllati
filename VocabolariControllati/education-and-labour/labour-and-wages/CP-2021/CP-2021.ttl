  clvapit:hasRankOrder "5"^^xsd:int;
  skos:prefLabel "Addetti al lavaggio veicoli"@it;
  skos:definition "Le professioni classificate in questa unità lavano a mano vetri e parti esterne di automobili o altri veicoli; utilizzano aspirapolveri, strumenti di pulitura a secco o detergenti per rimuovere polvere o macchie dalle tappezzerie interne."@it .

