<https://w3id.org/italia/controlled-vocabulary/territorial-classifications/continents>
  rdf:type      skos:ConceptScheme , adms:Asset , dcatapit:Dataset ;
  dct:title "Controlled Vocabulary for Continents"@en , "Vocabolario Controllato dei Continenti"@it ;
  dct:description "Un continente è un vasto complesso di terre emerse circondato dagli oceani, la cui delimitazione e suddivisione può variare in base all'adozione di criteri di tipo geografico, geopolitico o storico-culturale. In ambito statistico nazionale, l’Istat adotta la ripartizione basata su criteri geografici, considerando il mondo suddiviso in 5 continenti: Europa, Africa, Asia, America e Oceania."@it, "A continent is a vast landmass surrounded by oceans, whose delimitation and subdivision may vary according to the adoption of geographical, geopolitical or historical-cultural criteria. Within the field of national statistics, Istat adopts the division based on geographical criteria, considering the world as divided into 5 continents: Europe, Africa, Asia, America and Oceania."@en;
  xkos:numberOfLevels "1"^^xsd:positiveInteger ;
  dct:type <http://purl.org/adms/assettype/CodeList> ;
  adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
  dct:identifier "https://w3id.org/italia/controlled-vocabulary/territorial-classifications/continents";
  dct:rightsHolder <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dct:creator <https://w3id.org/italia/data/public-organization/ISTAT>  ;
  dct:publisher <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/REGI> ;
  dct:conformsTo  <https://w3id.org/italia/data/standard/SKOS> ;
  dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
  rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/continents> ;
  dct:subject <https://w3id.org/italia/controlled-vocabulary/themes/territorial-classifications> ;
  dcat:keyword "Continenti"@it, "Continents"@en ;
  dcat:distribution <https://w3id.org/italia/data/distribution/continents_RDF_Turtle> , <https://w3id.org/italia/data/distribution/continents_CSV> , <https://w3id.org/italia/data/distribution/continents_XLSX> ;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;
  dct:issued "2026-10-26"^^xsd:date ;
  dct:modified "2026-10-26"^^xsd:date ;
  dct:temporal "Da ottobre 2026" ;
  owl:versionInfo "Versione 1.0 - Dati riferiti al 31 dicembre 2025"@it ; 
  ndc:keyConcept "continents" ;
  rdfs:comment "Controlled Vocabulary for Continents"@en , "Vocabolario Controllato dei Continenti"@it ;
  rdfs:label "Controlled Vocabulary for Continents"@en , "Vocabolario Controllato dei Continenti"@it ;
  skos:prefLabel "Controlled Vocabulary for Continents"@en , "Vocabolario Controllato dei Continenti"@it .   


