    <!-- https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces -->

    <NamedIndividual rdf:about="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces">
        <rdf:type rdf:resource="http://dati.gov.it/onto/dcatapit#Dataset"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdf:type rdf:resource="http://www.w3.org/ns/adms#Asset"/>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:conformsTo rdf:resource="https://w3id.org/italia/data/resource/Standard/SKOS"/>
        <dct:creator rdf:resource="https://w3id.org/italia/data/public-organization/agid"/>
        <dct:creator rdf:resource="https://w3id.org/italia/data/resource/Amministrazione/td_PCM"/>
        <dct:description xml:lang="en">Controlled Vocabulary of Territorial units of intermediate area level between the municipality and the region. The units include provinces, metropolitan cities, autonomous province (Trentino Alto Adige), free municipal consortiums (Sicilia), and non-administrative units (Friuli Venezia Giulia).</dct:description>
        <dct:description xml:lang="it">Vocabolario controllato delle Unità territoriali di livello intermedio tra il Comune e la Regione. Tali unità comprendono le province, le città metropolitane, le province autonome (Trentino Alto Adige), i liberi consorzi di Comuni (Sicilia), e le unità territoriali non amministrative (Friuli Venezia Giulia).</dct:description>
        <dct:identifier>agid:D.14</dct:identifier>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-06-19</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ITA"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-03</dct:modified>
        <dct:publisher rdf:resource="https://w3id.org/italia/data/public-organization/PCM-1RSIZZ"/>
        <dct:rightsHolder rdf:resource="https://w3id.org/italia/data/public-organization/ISTAT"/>
        <dct:title xml:lang="en">Provinces of Italy and the Metropolitan Cities Controlled Vocabulary</dct:title>
        <dct:title xml:lang="it">Vocabolario Controllato delle Province d&apos;Italia e delle Città metropolitane</dct:title>
        <dct:type rdf:resource="http://purl.org/adms/assettype/CodeList"/>
        <xkos:numberOfLevels>1</xkos:numberOfLevels>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces"/>
        <versionInfo xml:lang="it">3.0 - Aggiornamento allineato alla riforma dell’assetto territoriale della Regione Sardegna, in vigore dal 17 luglio 2025, che istituisce la Città metropolitana di Sassari e le nuove Province della Gallura Nord-Est Sardegna, dell’Ogliastra, del Sulcis Iglesiente e del Medio Campidano e sopprime le Province di Sassari e del Sud Sardegna. Le nuove denominazioni e i nuovi codici statistici delle unità amministrative saranno utilizzati a partire dal 1° gennaio 2026.</versionInfo>
        <skos:hasTopConcept rdf:resource="https://w3id.org/italia/controlled-vocabulary/territorial-classifications/provinces/001"/>
