# linkset
#################################################################

<https://w3id.org/italia/data/linkset/uts_aligns_costituite>
    a void:Linkset , dcatapit:Dataset ;
    dct:title "Allineamento tra il vocabolario controllato delle UTS e il vocabolario controllato delle UTS costituite o annesse da Stato estero"@it ,
              "Alignment between the controlled vocabulary of UTS and the controlled vocabulary of UTS established or annexed from a foreign state"@en ;
    dct:description "Dataset di raccordo che esprime gli allineamenti SKOS tra i concetti del vocabolario controllato delle UTS e i concetti del vocabolario controllato delle UTS costituite o annesse da Stato estero."@it ,
                    "Linkset expressing SKOS mappings between concepts in the controlled vocabulary of UTS and the concepts in the controlled vocabulary of UTS established or annexed from a foreign state."@en ;
    dct:relation <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts> ,
                 <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts_costituite> ;
    void:subjectsTarget <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts> ;
    void:objectsTarget <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts_costituite> ;
    void:linkPredicate skos:exactMatch ;
    dcat:distribution <https://w3id.org/italia/data/distribution/uts_aligns_costituite_RDF_Turtle> .


