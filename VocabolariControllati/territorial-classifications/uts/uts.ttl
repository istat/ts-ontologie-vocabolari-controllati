  rdfs:label "Controlled Vocabulary for Territorial Statistical Units UTS"@en , "Vocabolario Controllato delle Unità Statistiche Territoriali UTS"@it ;
  skos:notation "Controlled Vocabulary for Territorial Statistical Units UTS"@en , "Vocabolario Controllato delle Unità Statistiche Territoriali UTS"@it ;     
  skos:prefLabel "Controlled Vocabulary for Territorial Statistical Units UTS"@en , "Vocabolario Controllato delle Unità Statistiche Territoriali UTS"@it ;     
  dct:relation <https://w3id.org/italia/data/linkset/uts_aligns_costituite> ;
  rdfs:seeAlso <https://w3id.org/italia/data/linkset/uts_aligns_costituite> . 
   
   
