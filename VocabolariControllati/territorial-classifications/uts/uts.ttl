<https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts>
  rdf:type      skos:ConceptScheme , adms:Asset , dcatapit:Dataset ;
  dct:title "Controlled Vocabulary for Territorial Statistical Units UTS"@en , "Vocabolario Controllato delle Unità Statistiche Territoriali UTS"@it ;
  dct:description "Vocabolario controllato delle Unità territoriali di livello intermedio tra il Comune e la Regione al 01/01/2026. Tali unità comprendono le province, le città metropolitane, le province autonome (Trentino Alto Adige), i liberi consorzi di Comuni (Sicilia), e le unità territoriali non amministrative (Friuli Venezia Giulia)."@it , "Controlled Vocabulary of Territorial units of intermediate area level between the municipality and the region at 2026/01/01. The units include provinces, metropolitan cities, autonomous province (Trentino Alto Adige), free municipal consortiums (Sicilia), and non-administrative units (Friuli Venezia Giulia)."@en ;
  xkos:numberOfLevels "1" ;
  dct:type <http://purl.org/adms/assettype/CodeList> ;
  adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
  dct:identifier "https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts";
  dct:rightsHolder <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dct:creator <https://w3id.org/italia/data/public-organization/ISTAT>  ;
  dct:publisher <https://w3id.org/italia/data/public-organization/ISTAT> ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/REGI> ;
  dct:conformsTo  <https://w3id.org/italia/data/standard/SKOS> ;
  dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
  rdfs:isDefinedBy <https://w3id.org/italia/controlled-vocabulary/territorial-classifications/uts> ;
  dcat:keyword "uts"@it , "Provincia"@it , "Province"@it , "Città metropolitana"@it , "Provincia autonoma"@it, "Libero consorzio di comuni"@it, "Unità territoriale non amministrativa"@it , "uts"@en , "Province"@en , "Provinces"@en , "Metropolitan city"@en , "Autonomous province"@en , "Free municipal consortium"@en , "Non-administrative unit"@en ;
  dcat:distribution <https://w3id.org/italia/data/distribution/uts_RDF_Turtle>, <https://w3id.org/italia/data/distribution/uts_CSV>, <https://w3id.org/italia/data/distribution/uts_XLSX> , <https://w3id.org/italia/data/distribution/uts_aligns_costituite_RDF_Turtle> ;                             
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;                                                                                                                                                               
  dct:issued "2026-03-25"^^xsd:date ;
